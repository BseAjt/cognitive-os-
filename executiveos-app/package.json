{
  "name": "executiveos",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:runtime && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e:headed": "playwright test --headed",
    "validate": "npm run test:runtime && npm run typecheck && next build && npm run test:e2e:typecheck && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "@xyflow/react": "12.11.2",
    "ai": "7.0.58",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
