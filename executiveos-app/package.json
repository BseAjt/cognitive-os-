{
  "name": "executiveos",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e:headed": "playwright test --headed",
    "validate": "npm run test:runtime && npm run typecheck && npm run build && npm run test:e2e:typecheck && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "@xyflow/react": "12.11.2",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.0"
  }
}
